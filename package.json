{
  "name": "qge-anime",
  "version": "1.0.0",
  "description": "GQE anime — an anime quiz game site (Payload + Supabase Realtime + Turso)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "db:push": "cross-env NODE_OPTIONS=--no-deprecation supabase db push",
    "auth:backfill": "bun --conditions=react-server src/scripts/backfill-supabase-auth.ts",
    "seed:sounds": "bun --conditions=react-server src/scripts/seed-default-sounds.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/richtext-lexical": "3.85.0",
    "@payloadcms/storage-s3": "3.85.0",
    "@payloadcms/ui": "3.85.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/postcss": "^4.3.1",
    "cross-env": "^7.0.3",
    "daisyui": "^5.5.23",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "payload": "3.85.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.6.0",
    "react-player": "^3.4.0",
    "react-qr-code": "^2.2.0",
    "server-only": "^0.0.1",
    "sharp": "0.34.2",
    "tailwindcss": "^4.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.4.2",
    "typescript": "5.7.3"
  },
  "trustedDependencies": [
    "sharp",
    "esbuild",
    "unrs-resolver"
  ]
}
